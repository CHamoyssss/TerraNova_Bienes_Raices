@page "/trabajadores/registrar"
@page "/trabajadores/registrar/{Id:int}"
@inject ServicioTrabajadores ServicioTrabajadores
@inject NavigationManager NavigationManager

<PageTitle>@(esEdicion ? "Editar Trabajador" : "Nuevo Trabajador")</PageTitle>

<div class="dashboard-container">
    <h2 class="fw-bold mb-4">@(esEdicion ? "Editar Trabajador" : "Registrar Nuevo Trabajador")</h2>

    <div class="panel-card shadow-sm p-4">

        @if (cargando)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="trabajador" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                @if (mensajeError != null)
                {
                    <div class="alert alert-danger">@mensajeError</div>
                }

                <div class="d-flex align-items-center mb-4">
                    <div class="foto-preview-wrapper me-3">
                        @if (!string.IsNullOrWhiteSpace(fotoPreview))
                        {
                            <img src="@fotoPreview" class="foto-preview" alt="Foto del trabajador" />
                        }
                        else
                        {
                            <div class="foto-preview-placeholder">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <InputFile OnChange="CargarFoto" class="d-none" id="inputFoto" accept="image/*" />
                        <label for="inputFoto" class="btn btn-outline-primary">
                            <i class="bi bi-camera"></i> @(string.IsNullOrWhiteSpace(fotoPreview) ? "Subir foto" : "Cambiar foto")
                        </label>
                        @if (!string.IsNullOrWhiteSpace(fotoPreview))
                        {
                            <button type="button" class="btn btn-outline-danger ms-2" @onclick="QuitarFoto">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                        @if (errorFoto != null)
                        {
                            <div class="text-danger small mt-1">@errorFoto</div>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="trabajador.Nombre" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="trabajador.Apellido" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cédula de Identidad</label>
                        <InputText class="form-control" @bind-Value="trabajador.Ci" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cargo</label>
                        <InputSelect class="form-select" @bind-Value="trabajador.Cargo">
                            <option value="Agente">Agente</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Recepcionista">Recepcionista</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="trabajador.Telefono" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="trabajador.Email" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Porcentaje de Comisión (%)</label>
                        <InputNumber class="form-control" @bind-Value="trabajador.PorcentajeComision" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de Contratación</label>
                        <InputDate class="form-control" @bind-Value="trabajador.FechaContratacion" />
                    </div>
                </div>

                <div class="mb-4 form-check">
                    <InputCheckbox class="form-check-input" id="chkActivo" @bind-Value="trabajador.Activo" />
                    <label class="form-check-label" for="chkActivo">Activo</label>
                </div>

                <button type="submit" class="btn btn-success me-2" disabled="@guardando">
                    <i class="bi bi-check-circle"></i>
                    @(guardando ? "Guardando..." : (esEdicion ? "Actualizar" : "Guardar"))
                </button>
                <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                    Cancelar
                </button>
            </EditForm>
        }
    </div>
</div>

<style>
    .foto-preview-wrapper {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        background: #f1f1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #dee2e6;
    }

    .foto-preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .foto-preview-placeholder {
        font-size: 2.5rem;
        color: #adb5bd;
    }
</style>

@code {
    [Parameter]
    public int? Id { get; set; }

    private TrabajadorDTO trabajador = new() { Cargo = "Agente", FechaContratacion = DateTime.Now, Activo = true };
    private bool esEdicion => Id.HasValue;
    private bool cargando = false;
    private bool guardando = false;
    private string? mensajeError;
    private string? errorFoto;
    private string? fotoPreview;

    private const long TamanoMaximoFoto = 2 * 1024 * 1024; // 2 MB

    protected override async Task OnInitializedAsync()
    {
        if (esEdicion)
        {
            cargando = true;
            try
            {
                trabajador = await ServicioTrabajadores.Buscar(Id!.Value);
                fotoPreview = trabajador.FotoUrl;
            }
            catch (Exception ex)
            {
                mensajeError = "No se pudo cargar el trabajador: " + ex.Message;
            }
            finally
            {
                cargando = false;
            }
        }
    }

    private async Task CargarFoto(InputFileChangeEventArgs e)
    {
        errorFoto = null;
        try
        {
            var archivo = e.File;

            if (archivo.Size > TamanoMaximoFoto)
            {
                errorFoto = "La imagen no debe superar los 2 MB.";
                return;
            }

            using var stream = archivo.OpenReadStream(TamanoMaximoFoto);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var bytes = memoryStream.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var mimeType = archivo.ContentType;

            fotoPreview = $"data:{mimeType};base64,{base64}";
            trabajador.FotoUrl = fotoPreview;
        }
        catch (Exception ex)
        {
            errorFoto = "No se pudo cargar la imagen: " + ex.Message;
        }
    }

    private void QuitarFoto()
    {
        fotoPreview = null;
        trabajador.FotoUrl = null;
    }

    private async Task Guardar()
    {
        mensajeError = null;
        guardando = true;
        try
        {
            if (esEdicion)
            {
                await ServicioTrabajadores.Modificar(trabajador);
            }
            else
            {
                await ServicioTrabajadores.Guardar(trabajador);
            }

            NavigationManager.NavigateTo("/trabajadores");
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo guardar: " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/trabajadores");
    }
}