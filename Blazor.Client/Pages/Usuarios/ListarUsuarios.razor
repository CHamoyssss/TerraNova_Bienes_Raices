@page "/usuarios"
@inject ServicioUsuarios ServicioUsuarios
@inject ServicioAutenticacion ServicioAutenticacion
@inject NavigationManager NavigationManager

<PageTitle>Usuarios</PageTitle>

<div class="dashboard-container">

    @if (!ServicioAutenticacion.EsAdmin)
    {
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock"></i> No tienes permisos para acceder a esta sección. Solo el Administrador puede gestionar usuarios.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Usuarios del Sistema</h2>
                <p class="text-muted mb-0">Gestión de accesos y roles</p>
            </div>
            <button class="btn btn-primary" @onclick="IrARegistrar">
                <i class="bi bi-person-plus"></i> Nuevo Usuario
            </button>
        </div>

        @if (cargando)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (mensajeError != null)
        {
            <div class="alert alert-danger">@mensajeError</div>
        }
        else if (!usuarios.Any())
        {
            <div class="alert alert-info">No hay usuarios registrados.</div>
        }
        else
        {
            <div class="panel-card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Nombre de Usuario</th>
                                <th>Rol</th>
                                <th>Trabajador Vinculado</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in usuarios)
                            {
                                <tr>
                                    <td>@usuario.NombreUsuario</td>
                                    <td>
                                        <span class="badge @(usuario.Rol == "Admin" ? "bg-danger" : "bg-primary")">@usuario.Rol</span>
                                    </td>
                                    <td>@usuario.IdTrabajadorNavigation?.Nombre @usuario.IdTrabajadorNavigation?.Apellido</td>
                                    <td>
                                        @if (usuario.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-warning me-1" @onclick="() => IrAEditar(usuario.Id)">
                                            <i class="bi bi-pencil"></i>Modificar
                                        </button>
                                        @if (usuario.Activo)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => MostrarConfirmacion(usuario.Id)">
                                                <i class="bi bi-person-dash"></i>Eliminar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar Baja
                    </h5>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-person-dash text-danger" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0 fw-medium">¿Dar de baja a este usuario?</p>
                    <p class="text-muted small mb-0">Esta accion no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn btn-secondary px-4" @onclick="CancelarEliminacion">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                    <button class="btn btn-danger px-4" @onclick="EliminarRegistro">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UsuarioDTO> usuarios = new();
    private bool cargando = true;
    private string? mensajeError;
    private bool mostrarModalConfirmacion = false;
    private int idAEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (!ServicioAutenticacion.EsAdmin)
        {
            cargando = false;
            return;
        }

        try
        {
            usuarios = await ServicioUsuarios.Lista();
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo cargar la lista de usuarios: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrARegistrar()
    {
        NavigationManager.NavigateTo("/usuarios/registrar");
    }

    private void IrAEditar(int id)
    {
        NavigationManager.NavigateTo($"/usuarios/registrar/{id}");
    }

    private void MostrarConfirmacion(int id)
    {
        if (!ServicioAutenticacion.EsAdmin) return;
        idAEliminar = id;
        mostrarModalConfirmacion = true;
    }

    private void CancelarEliminacion()
    {
        mostrarModalConfirmacion = false;
    }

    private async Task EliminarRegistro()
    {
        mostrarModalConfirmacion = false;
        try
        {
            await ServicioUsuarios.Eliminar(idAEliminar);
            usuarios = await ServicioUsuarios.Lista();
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo dar de baja: " + ex.Message;
        }
    }
}