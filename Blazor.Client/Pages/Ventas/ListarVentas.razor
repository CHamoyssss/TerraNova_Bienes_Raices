@page "/ventas"
@inject ServicioVentas ServicioVentas
@inject NavigationManager NavigationManager

@inject Services.ToastService ToastService

<PageTitle>Ventas</PageTitle>

<div class="dashboard-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Ventas</h2>
            <p class="text-muted mb-0">Historial de transacciones</p>
        </div>
        <button class="btn btn-primary" @onclick="IrARegistrar">
            <i class="bi bi-cart-plus"></i> Nueva Venta
        </button>
    </div>

    <div class="panel-card shadow-sm mb-4 p-3">
        <input type="text" class="form-control w-50"
               placeholder="Buscar por cliente, propiedad o agente..."
               @bind="textoBusqueda" @bind:event="oninput" @onkeyup="Filtrar" />
    </div>

    @if (cargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (mensajeError != null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
    else if (!ventasFiltradas.Any())
    {
        <div class="alert alert-info">No se registraron ventas todavía.</div>
    }
    else
    {
        <div class="panel-card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Propiedad</th>
                            <th>Agente</th>
                            <th>Monto</th>
                            <th>Comisión</th>
                            <th>Forma de Pago</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in ventasFiltradas)
                        {
                            <tr>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@venta.IdClienteNavigation?.Nombre @venta.IdClienteNavigation?.Apellido</td>
                                <td>@venta.IdPropiedadNavigation?.Titulo</td>
                                <td>@venta.IdTrabajadorNavigation?.Nombre @venta.IdTrabajadorNavigation?.Apellido</td>
                                <td>@($"${venta.Monto:N0}")</td>
                                <td>@($"${venta.ComisionGenerada:N2}")</td>
                                <td>@venta.FormaPago</td>
                                <td>
                                    <span class="badge @ObtenerClaseEstado(venta.Estado)">@venta.Estado</span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning me-1" @onclick="() => IrAModificar(venta.Id)">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => MostrarConfirmacion(venta.Id)">
                                        <i class="bi bi-x-circle"></i> Cancelar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarModalConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Cancelar Venta
                    </h5>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-x-circle text-danger" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0 fw-medium">¿Cancelar esta venta?</p>
                    <p class="text-muted small mb-0">La propiedad volvera a estar Disponible.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button class="btn btn-secondary px-4" @onclick="CancelarEliminacion">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                    <button class="btn btn-danger px-4" @onclick="EliminarRegistro">
                        <i class="bi bi-check-lg"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VentaDTO> ventas = new();
    private List<VentaDTO> ventasFiltradas = new();
    private string textoBusqueda = string.Empty;
    private bool cargando = true;
    private string? mensajeError;
    private bool mostrarModalConfirmacion = false;
    private int idAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            ventas = await ServicioVentas.Lista();
            ventasFiltradas = ventas;
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al cargar ventas");
            mensajeError = "No se pudo cargar la lista de ventas: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void Filtrar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            ventasFiltradas = ventas;
        }
        else
        {
            var texto = textoBusqueda.ToLower();
            ventasFiltradas = ventas.Where(v =>
                (v.IdClienteNavigation?.Nombre?.ToLower().Contains(texto) ?? false) ||
                (v.IdClienteNavigation?.Apellido?.ToLower().Contains(texto) ?? false) ||
                (v.IdPropiedadNavigation?.Titulo?.ToLower().Contains(texto) ?? false) ||
                (v.IdTrabajadorNavigation?.Nombre?.ToLower().Contains(texto) ?? false) ||
                (v.IdTrabajadorNavigation?.Apellido?.ToLower().Contains(texto) ?? false)).ToList();
        }
    }

    private void IrARegistrar()
    {
        NavigationManager.NavigateTo("/ventas/registrar");
    }

    private void IrAModificar(int id)
    {
        NavigationManager.NavigateTo($"/ventas/registrar/{id}");
    }

    private void MostrarConfirmacion(int id)
    {
        idAEliminar = id;
        mostrarModalConfirmacion = true;
    }

    private void CancelarEliminacion()
    {
        mostrarModalConfirmacion = false;
    }

    private async Task EliminarRegistro()
    {
        mostrarModalConfirmacion = false;
        try
        {
            await ServicioVentas.Eliminar(idAEliminar);
            ToastService.ShowSuccess("Venta cancelada correctamente");
            await CargarVentas();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"No se pudo cancelar la venta: {ex.Message}");
            mensajeError = "No se pudo cancelar la venta: " + ex.Message;
        }
    }

    private string ObtenerClaseEstado(string estado)
    {
        return estado switch
        {
            "Completada" => "bg-success",
            "En proceso" => "bg-warning text-dark",
            "Cancelada" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
